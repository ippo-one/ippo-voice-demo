# Copy to .env.local (git-ignored) and fill in. Keys stay on the dev server; the browser never sees them.

# LoanPilot Agents (agent.ippo.one): Settings → API keys. Starts with ippo_
LOANPILOT_AGENTS_API_KEY=
# Written by `pnpm agent:setup` (creates the Ippo agent)
IPPO_AGENT_ID=

# LoanPilot (app.ippo.one): Settings → API keys. Starts with lp_live_
LOANPILOT_API_KEY=

# The test applicant: the PAN check, credit pull and Account Aggregator SMS use these
TEST_NAME=
TEST_MOBILE=

# Optional overrides
# LOANPILOT_AGENTS_URL=https://agent.ippo.one
# LOANPILOT_URL=https://api.ippo.one/v1
# LOANPILOT_WEB_URL=https://app.ippo.one
